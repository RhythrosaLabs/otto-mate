# =============================================================================
# Otto Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env
#
# At minimum, you need ANTHROPIC_API_KEY for core functionality.
# Add more keys to unlock additional features.
# =============================================================================

# =============================================================================
# AI Provider APIs
# =============================================================================

# Anthropic (REQUIRED) - Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Optional) - Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Replicate (Recommended for image/video/audio) - Get token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# =============================================================================
# Voice APIs (Optional)
# =============================================================================

# ElevenLabs - Get key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# =============================================================================
# E-Commerce (Optional)
# =============================================================================

# Printify - Get token at: https://printify.com/app/account/api
PRINTIFY_API_TOKEN=your_printify_token_here
PRINTIFY_SHOP_ID=your_shop_id_here

# Shopify - Get credentials at your Shopify admin
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_PASSWORD=your_shopify_password_here
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here

# =============================================================================
# Web Search (Optional)
# =============================================================================

# Serper - Free 100 searches/month at: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Tavily - Get key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# Email (Optional)
# =============================================================================

# SendGrid - Free 100 emails/day at: https://sendgrid.com/
SENDGRID_API_KEY=your_sendgrid_api_key_here

# SMTP (alternative to SendGrid)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=your_email@example.com
EMAIL_PASSWORD=your_app_password_here

# =============================================================================
# Messaging Channels (Optional)
# =============================================================================

# Telegram - Get token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord - Get token from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Slack - Get tokens from Slack App settings
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_APP_TOKEN=your_slack_app_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# WhatsApp (via Twilio) - Get credentials at: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# =============================================================================
# Social Media Browser Automation (Optional)
# =============================================================================
# Credentials for auto-login during browser automation tasks.
# Leave blank to log in manually through the browser.

TWITTER_USERNAME=
TWITTER_PASSWORD=

INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

REDDIT_USERNAME=
REDDIT_PASSWORD=

# =============================================================================
# Server Configuration
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000
DEBUG_MODE=false

# =============================================================================
# Model Configuration
# =============================================================================

DEFAULT_AI_MODEL=claude-sonnet-4-20250514
FALLBACK_AI_MODEL=gpt-4-turbo-preview
MAX_TOKENS=4096
TEMPERATURE=0.7

# =============================================================================
# Database
# =============================================================================

DATABASE_URL=sqlite:///./data/otto.db

# =============================================================================
# Security
# =============================================================================

# Set a strong secret for JWT tokens (auto-generated if not set)
# JWT_SECRET_KEY=your_very_long_random_secret_here

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS - comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# Browser Automation
# =============================================================================

PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT=30000

# =============================================================================
# Tool Execution
# =============================================================================

MAX_TOOL_RETRIES=3
TOOL_TIMEOUT_SECONDS=300
