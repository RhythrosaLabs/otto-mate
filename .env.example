# ============================================================
# Otto Chat — Environment Configuration Example
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
# ============================================================

# ────────────────────────────────────────────────────────────
# Core AI APIs  (Anthropic is REQUIRED; others are optional)
# ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
REPLICATE_API_TOKEN=your_replicate_token_here

# ────────────────────────────────────────────────────────────
# Voice / Audio
# ────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ────────────────────────────────────────────────────────────
# E-Commerce
# ────────────────────────────────────────────────────────────
PRINTIFY_API_TOKEN=your_printify_api_token_here
PRINTIFY_SHOP_ID=your_printify_shop_id_here
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_PASSWORD=your_shopify_password_here
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here

# ────────────────────────────────────────────────────────────
# Search & Web
# ────────────────────────────────────────────────────────────
SERPER_API_KEY=your_serper_api_key_here

# ────────────────────────────────────────────────────────────
# Email / Newsletters
# ────────────────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ────────────────────────────────────────────────────────────
# Social Media (browser-automation credentials)
# ────────────────────────────────────────────────────────────
SOCIAL_MEDIA_ENABLED=false
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
LINKEDIN_EMAIL=your_linkedin_email
LINKEDIN_PASSWORD=your_linkedin_password
FACEBOOK_EMAIL=your_facebook_email
FACEBOOK_PASSWORD=your_facebook_password
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
YOUTUBE_USERNAME=your_youtube_username
YOUTUBE_PASSWORD=your_youtube_password
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_API_KEY=your_youtube_api_key

# ────────────────────────────────────────────────────────────
# Discord Bot
# ────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_APPLICATION_ID=your_discord_application_id
DISCORD_USERNAME=your_discord_username
DISCORD_PASSWORD=your_discord_password

# ────────────────────────────────────────────────────────────
# Music Platforms
# ────────────────────────────────────────────────────────────
SOUNDCLOUD_EMAIL=your_soundcloud_email
SOUNDCLOUD_PASSWORD=your_soundcloud_password
BANDCAMP_EMAIL=your_bandcamp_email
BANDCAMP_PASSWORD=your_bandcamp_password
BANDCAMP_CLIENT_ID=your_bandcamp_client_id
BANDCAMP_CLIENT_SECRET=your_bandcamp_client_secret

# ────────────────────────────────────────────────────────────
# Webhooks
# ────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=https://yourdomain.com
REPLICATE_WEBHOOK_SECRET=your_replicate_webhook_secret
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
YOUTUBE_WEBHOOK_VERIFY_TOKEN=your_youtube_webhook_verify_token

# ────────────────────────────────────────────────────────────
# Server / App Configuration
# ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG_MODE=false
OTTO_AUTH_ENABLED=false

# ────────────────────────────────────────────────────────────
# AI Model Defaults
# ────────────────────────────────────────────────────────────
DEFAULT_AI_MODEL=claude-sonnet-4-20250514
FALLBACK_AI_MODEL=gpt-4-turbo-preview
MAX_TOKENS=4096
TEMPERATURE=0.7

# ────────────────────────────────────────────────────────────
# Database (SQLite by default — no setup needed)
# ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./otto.db
