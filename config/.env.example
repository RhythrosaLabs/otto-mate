# Core AI APIs
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
REPLICATE_API_TOKEN=your_replicate_token_here

# Voice APIs
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Messaging APIs
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Business APIs (from Otto Platform)
PRINTIFY_API_TOKEN=your_printify_token
SHOPIFY_API_KEY=your_shopify_key
SHOPIFY_PASSWORD=your_shopify_password
SHOPIFY_STORE_URL=your-store.myshopify.com
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# Database
DATABASE_URL=postgresql://otto:password@localhost:5432/otto_universal
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ChromaDB (Vector Store)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Ray (Distributed Computing)
RAY_ADDRESS=auto
RAY_DASHBOARD_PORT=8265

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false
DEBUG_MODE=false

# Security
JWT_SECRET_KEY=your_very_secret_jwt_key_change_this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
API_KEY_HEADER=X-API-Key

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/otto.log
SENTRY_DSN=your_sentry_dsn_here

# Model Configurations
DEFAULT_AI_MODEL=claude-sonnet-4-20250514
FALLBACK_AI_MODEL=gpt-4-turbo-preview
MAX_TOKENS=4096
TEMPERATURE=0.7

# Voice Settings
VOICE_MODEL=whisper-1
TTS_MODEL=eleven_multilingual_v2
TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
SAMPLE_RATE=16000
AUDIO_FORMAT=wav

# Websocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# Tool Execution
MAX_TOOL_RETRIES=3
TOOL_TIMEOUT_SECONDS=300
PARALLEL_TOOL_LIMIT=10

# Memory Settings
MEMORY_MAX_HISTORY=50
MEMORY_SIMILARITY_THRESHOLD=0.7
MEMORY_TOP_K=5

# Browser Automation
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT=30000
SCREENSHOT_PATH=./data/screenshots

# File Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=100MB
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.mp4,.mp3,.pdf,.doc,.docx

# Monitoring
PROMETHEUS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Development
MOCK_EXTERNAL_APIS=false
ENABLE_PROFILING=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
