# Otto Gateway & Channels Configuration Example
# Copy this to .env or config.yaml

# ===========================
# Gateway Configuration
# ===========================

ENABLE_GATEWAY=true
ENABLE_VOICE_WAKE=false  # Requires pvporcupine
ENABLE_TALK_MODE=true    # Requires whisper, elevenlabs
WAKE_WORD="hey otto"

# ===========================
# Telegram Channel
# ===========================

# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Allowed users (telegram user IDs) - use "*" for all
TELEGRAM_ALLOW_FROM=["*"]

# Allowed groups (telegram chat IDs)
TELEGRAM_GROUPS={}

# ===========================
# Discord Channel
# ===========================

# Get token from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Allowed guilds (server IDs) - use "*" for all
DISCORD_GUILDS={"*": true}

# Allowed users (discord user IDs) - use "*" for all
DISCORD_ALLOW_FROM=["*"]

# ===========================
# Slack Channel
# ===========================

# Get tokens from Slack App settings
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Allowed workspaces
SLACK_WORKSPACES={"*": true}

# Allowed channels (slack channel IDs) - use "*" for all
SLACK_CHANNELS={"*": true}

# ===========================
# Voice Configuration
# ===========================

# STT Provider: whisper, google, azure
STT_PROVIDER=whisper

# TTS Provider: elevenlabs, google, azure, coqui
TTS_PROVIDER=elevenlabs

# ElevenLabs config
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=Adam

# ===========================
# Skills Configuration
# ===========================

# Email skill
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Calendar skill
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=./credentials.json
